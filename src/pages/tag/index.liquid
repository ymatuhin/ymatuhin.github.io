---
layout: default
title: Теги
permalink: /tags/
redirects:
- /tag/
---

<article class="post typo white-content wrap-inner">
  <header class="post-header">
    <h1 class="post-header__title">Теги</h1>
  </header>

  <nav class="tags-nav" aria-label="Теги и количество публикаций">
    {%- for tagPage in collections.tagPages -%}
      <a href="/tag/{{ tagPage.slug }}/">{{ tagPage.name }}&nbsp;({{ tagPage.count
      }})</a>{% if forloop.last == false %}  {% endif %}
    {%- endfor -%}
  </nav>
</article>

{% css %}
  .tags-nav {
    line-height: 2;
  }
{% endcss %}
