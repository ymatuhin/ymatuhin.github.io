---
layout: default
pagination:
  data: collections.posts
  size: 12
  alias: postsPage
permalink: "/posts/{% if pagination.pageNumber > 0 %}{{ pagination.pageNumber | plus: 1 }}/{% endif %}index.html"
eleventyComputed:
  title: "Все заметки, страница #{{ pagination.pageNumber | plus: 1 }}"
  description: "Архив публикаций Юрия Матюхина о фронтенд-разработке и технологиях. Страница {{ pagination.pageNumber | plus: 1 }}."
---

<h1>Все заметки</h1>

<div class="cards cards--list">
  {% for post in postsPage %}
    {% assign cardImageLoading = "lazy" %}
    {% if forloop.first %}
      {% assign cardImageLoading = "eager" %}
    {% endif %}
    {% include "posts/post-card.liquid"
      tag: "h2",
      tags: post.data.tags,
      date: post.date,
      imagePath: post.data.image.path,
      imageAlt: post.data.image.alt,
      imageLoading: cardImageLoading,
      link: post.url,
      title: post.data.title,
      description: post.data.description %}
  {% endfor %}
</div>

<hr class="divider">

<nav class="posts-pagination" aria-label="Предыдущая и следующая страница">
  {% if pagination.href.next %}
    <a class="posts-pagination__older / button" href="{{ pagination.href.next }}"> « Старее</a>
  {% endif %}
  {% if pagination.href.previous %}
    <a class="posts-pagination__newer / button" href="{{ pagination.href.previous }}">Новее »</a>
  {% endif %}
</nav>

{% css %}
  {% include "styles/cards.css" %}
  {% include "styles/posts-pagination.css" %}
{% endcss %}
