<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | json }},
  "description": {{ description | json }},
  "keywords": {{ tags | join: ", " | json }},
  "datePublished": {{ page.date | date: "%Y-%m-%dT%H:%M:%S.%LZ" | json }},
  "dateModified": "{% modified %}",
  "inLanguage": {{ languageTag | default: "ru-RU" | json }},
  "author": {
    "@type": "Person",
    "@id": {{ site.url | append: "/#author" | json }},
    "name": {{ site.social.name | json }},
    "url": {{ site.url | append: "/" | json }},
    "sameAs": [
      {{ site.social.githubUrl | json }},
      {{ site.social.twitterUrl | json }},
      {{ site.social.vkUrl | json }}
    ]
  },
  "publisher": {
    "@type": "Person",
    "@id": {{ site.url | append: "/#author" | json }},
    "name": {{ site.social.name | json }},
    "url": {{ site.url | append: "/" | json }}
  }{% if image and image.path %},
  "image": {
    "@type": "ImageObject",
    "url": {{ site.url | append: "/assets/img/" | append: image.path | json }}
  }{% endif %},
  "url": {{ site.url | append: page.url | json }},
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ site.url | append: page.url | json }}
  }
}
</script>
