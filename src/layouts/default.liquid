<!DOCTYPE html>
<html lang="{{ lang | default: site.lang | default: 'ru' }}">

  {% unless currentTagPage and currentTagPage.slug %}
    {% html "head" %}
      <link rel="alternate" href="{{ site.feed_url }}" type="application/rss+xml" title="{{ site.title }}">
    {% endhtml %}
  {% endunless %}

  {% include "page/head.liquid" %}

  <div class="layout{% if layoutClass %} {{ layoutClass }}{% endif %}">
    <div class="layout__content">
      {% if lang == "en" %}
        {% include "page/header-en.liquid" %}
      {% else %}
        {% include "page/header.liquid" %}
      {% endif %}

      <main class="layout__main">{{ content }}</main>
    </div>

    {% if lang == "en" %}
      {% include "page/footer-en.liquid", class: 'layout__footer' %}
    {% else %}
      {% include "page/footer.liquid", class: 'layout__footer' %}
    {% endif %}
  </div>

  {% css %}
    {% include "styles/layout.css" %}
  {% endcss %}

  <img src="https://mc.yandex.ru/watch/28017147" style="position:absolute; left:-9999px;" alt="" />

  <script src="/assets/js/links-animation.js" type="module"></script>
</html>
